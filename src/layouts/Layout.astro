---
import '../styles/ui.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Tarot Table',
  description = 'A touch-first tarot table: shuffle, draw, lay spreads and read cards on any device.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#202028" />
    <meta name="color-scheme" content="dark" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Tarot" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --font-ui: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    --font-display: Georgia, 'Times New Roman', serif;
    --color-bg: #202028;
    --color-panel: #1a1a1f;
    --color-panel-border: #2e2e36;
    --color-text: #e6e2d8;
    --color-text-muted: #a3a09a;
    --color-accent: #d4af37;
    --color-accent-ink: #121212;
    --color-danger: #c0554f;
    --safe-top: env(safe-area-inset-top, 0px);
    --safe-right: env(safe-area-inset-right, 0px);
    --safe-bottom: env(safe-area-inset-bottom, 0px);
    --safe-left: env(safe-area-inset-left, 0px);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-ui);
    overscroll-behavior: none;
    -webkit-text-size-adjust: 100%;
  }

  /* Dynamic viewport height keeps the table above iOS Safari's bottom bar. */
  html {
    height: 100vh;
    height: 100dvh;
  }

  body {
    overflow: hidden;
  }

  button,
  select,
  input {
    font: inherit;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
