    "astro": "^5.17.1",
    "idb-keyval": "^6.3.0",
    "jszip": "^3.10.1",
    "vue": "^3.5.38",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@vite-pwa/astro": "^1.2.0",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
